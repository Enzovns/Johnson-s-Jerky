# ============================================================
# JOHNSON'S JERKY — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs
# ============================================================

# --- Supabase ---
# Trouvez ces valeurs dans : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...votre_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJ...votre_service_role_key

# --- Stripe ---
# Trouvez ces valeurs dans : Stripe Dashboard > Developers > API Keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Secret webhook : créé dans Stripe Dashboard > Developers > Webhooks
# URL à enregistrer : https://votre-domaine.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
