# ============================================================
# JOHNSON'S JERKY — Environment Variables
# Copy this file to .env.local and fill in the values
# ============================================================

# --- Airtable ---
# Create an account at https://airtable.com, then:
# API Key: https://airtable.com/create/tokens (Personal Access Token with data.records:read scope)
# Base ID: Found in the URL when viewing your base: airtable.com/YOUR_BASE_ID/...
# Table name: The exact name of your Products table in Airtable
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_PRODUCTS_TABLE=Products

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
